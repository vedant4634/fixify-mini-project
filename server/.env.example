# Fixify Backend - Environment Variables Example
# Copy this file to .env for local development or set these variables in the Render Dashboard

# Web Service Port & Environment
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (Set from your cloud MySQL provider e.g. Aiven, TiDB, Clever Cloud, Render MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fixify_db

# Optional Cloud DB SSL (set to true if cloud MySQL requires SSL/TLS)
DB_SSL=false

# Authentication Secret (Generate a strong random string for production)
JWT_SECRET=your_production_jwt_secret_key_change_this

# Allowed Frontend URL for CORS (Production Render frontend or localhost)
FRONTEND_URL=https://fixify-trusted-local-home-service.onrender.com
